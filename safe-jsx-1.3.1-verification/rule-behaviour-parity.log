# The eslintrc-style configs.recommended object was restructured in the emitted
# JS, so the legacy path gets its own check on ESLint 8.

$ npm i eslint@8 && node t3.cjs      # plugin.configs.recommended, eslintrc style
  eslint 8.57.1 + eslint-plugin-safe-jsx@1.3.0
    reports: NONE
    fixed  : const A = () => Boolean(a) && <div />;
  eslint 8.57.1 + eslint-plugin-safe-jsx@1.3.1
    reports: NONE
